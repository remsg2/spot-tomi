# Copier en .env.local pour le développement.
# Ces variables sont lues au RUNTIME côté serveur (jamais au build) :
# ne jamais les préfixer par NEXT_PUBLIC_.

# local | staging | production
APP_ENV=local

# Supabase local (`npx supabase start` affiche ces valeurs) ou projet dev.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_remplacer_moi

# Réservée au serveur (Edge Functions, actions serveur). Jamais dans le bundle client.
# SUPABASE_SECRET_KEY=
