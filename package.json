{
  "name": "spot-tomi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:db": "supabase test db",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "icons": "node scripts/generate-icons.mjs",
    "geo:countries": "node scripts/build-countries.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@serwist/next": "9.5.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "exifr": "7.1.3",
    "heic-to": "1.6.7",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@serwist/cli": "9.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "serwist": "9.5.15",
    "sharp": "0.35.5",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
